# Accès direct à la base, pour les migrations et le service de compilation.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ---------------------------------------------------------------------------
# Source de données du studio (application navigateur).
#
# Sans ces deux variables, l'application sert les sites de référence du dépôt
# de code, en mémoire, et le dit à l'écran. Avec elles, elle lit le dépôt réel
# par l'API REST de PostgreSQL.
#
# Aucune valeur réelle ne figure ici, et aucune ne doit être commise (A2.4).
# Copier ce fichier en `.env.local`, qui est ignoré par git.
# ---------------------------------------------------------------------------

# Racine de l'API REST, sans barre oblique finale.
VITE_AZIMUT_API_URL=

# Clé publiable. Elle n'ouvre rien par elle-même : le cloisonnement par
# organisation est appliqué par la base, ligne à ligne.
VITE_AZIMUT_API_KEY=

# Schéma interrogé. Par défaut : azimut.
VITE_AZIMUT_DB_SCHEMA=azimut
