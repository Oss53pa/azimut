# Accès direct à la base, pour les migrations et le service de compilation.
# Sans valeur réelle (A6.3) : les deux marqueurs se remplacent en local.
DATABASE_URL=postgresql://<utilisateur>:<mot-de-passe>@localhost:54322/postgres

# A13.1 — l'environnement : local, recette ou production.
#
# `pnpm db:reset` refuse de s'exécuter ailleurs qu'en local, et vérifie en
# outre que la base est jointe par une adresse de bouclage : la déclaration
# dit une intention, l'adresse dit le fait.
AZIMUT_ENV=local

# ---------------------------------------------------------------------------
# Source de données du studio (application navigateur).
#
# Sans ces deux variables, l'application sert les sites de référence du dépôt
# de code, en mémoire, et le dit à l'écran. Avec elles, elle lit le dépôt réel
# par l'API REST de PostgreSQL.
#
# Aucune valeur réelle ne figure ici, et aucune ne doit être commise (A2.4).
# Copier ce fichier en `.env.local`, qui est ignoré par git.
# ---------------------------------------------------------------------------

# Racine de l'API REST, sans barre oblique finale.
VITE_AZIMUT_API_URL=

# Clé publiable. Elle n'ouvre rien par elle-même : le cloisonnement par
# organisation est appliqué par la base, ligne à ligne.
VITE_AZIMUT_API_KEY=

# Schéma interrogé. Par défaut : azimut.
VITE_AZIMUT_DB_SCHEMA=azimut

# ---------------------------------------------------------------------------
# Banc d'essai d'étanchéité par PostgREST (A10.4).
#
# Aucune de ces variables n'a de valeur dans le dépôt. Sans elles, la suite
# d'étanchéité se saute ; avec `AZIMUT_REQUIRE_POSTGREST`, elle échoue au lieu
# de se sauter. Voir `packages/db/migrations/ORDRE.md`.
# ---------------------------------------------------------------------------

# Le binaire PostgREST, par son chemin.
AZIMUT_TEST_POSTGREST=

# La base d'essai, jointe par le rôle propriétaire du schéma.
AZIMUT_TEST_DATABASE_URL=

# La même base, jointe par le rôle `authenticator` auquel PostgREST se
# connecte. Jamais le rôle propriétaire : il contournerait le cloisonnement.
AZIMUT_TEST_POSTGREST_DB_URI=

# Le secret de signature des jetons du banc. À tirer au hasard, par exemple
# avec `openssl rand -hex 32`, et à ne jamais écrire dans le dépôt.
AZIMUT_TEST_JWT_SECRET=

# Posée par une chaîne dont c'est le travail d'exécuter la suite d'étanchéité.
AZIMUT_REQUIRE_POSTGREST=
