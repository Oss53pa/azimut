{
  "name": "azimut",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck && tsc -p tsconfig.config.json",
    "lint": "eslint . && node scripts/check-deps.js",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:dist": "node scripts/secret-scan.mjs --dist apps/studio/dist apps/kiosk-runtime/dist",
    "test": "vitest run",
    "test:visual": "vitest run tests/visual.test.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:rls": "vitest run --config vitest.db.config.ts",
    "test:determinism": "vitest run tests/determinism.test.ts",
    "test:e2e": "playwright test",
    "build": "pnpm -r --parallel run build",
    "dev": "pnpm --filter @azimut/studio dev",
    "db:generate": "pnpm --filter @azimut/db db:generate",
    "db:migrate": "pnpm --filter @azimut/db db:migrate",
    "db:rollback": "pnpm --filter @azimut/db db:rollback",
    "db:reset": "pnpm --filter @azimut/db db:reset",
    "seed:reference": "pnpm --filter @azimut/db db:seed:reference",
    "audit:prod": "pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.63.0",
    "axe-core": "4.13.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=1.0.0 <1.1.20": "1.1.20",
      "brace-expansion@>=5.0.0 <5.0.11": "5.0.11",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2"
    }
  }
}
