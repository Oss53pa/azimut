{
  "name": "azimut",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint . && node scripts/check-deps.js",
    "test": "echo \"No tests configured yet\" && exit 0",
    "test:visual": "echo \"No visual tests configured yet\" && exit 0",
    "test:rls": "echo \"No RLS tests configured yet\" && exit 0",
    "test:determinism": "echo \"No determinism tests configured yet\" && exit 0",
    "test:e2e": "echo \"No e2e tests configured yet\" && exit 0",
    "build": "pnpm -r --parallel run build",
    "dev": "pnpm --filter @azimut/studio dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0"
  }
}
