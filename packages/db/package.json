{
  "name": "@azimut/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./mapping": {
      "types": "./src/mapping/index.ts",
      "import": "./src/mapping/index.ts"
    },
    "./reference": {
      "types": "./src/reference/index.ts",
      "import": "./src/reference/index.ts"
    }
  },
  "dependencies": {
    "@azimut/core-model": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.js",
    "db:rollback": "node scripts/rollback.js",
    "db:reset": "node scripts/reset.js",
    "db:seed:reference": "node scripts/seed-reference.js"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
